DATABASE_URL=sqlite:///./attendance.db
JWT_SECRET=dev-only-jwt-secret-change-this-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FACE_ENCRYPTION_KEY=dev-only-face-encryption-key-change-this
FACE_MATCH_THRESHOLD=0.82
FACE_MODEL_NAME=face-api-v1
FACE_LIVENESS_MIN_FRAMES=3
FACE_LIVENESS_MOVEMENT=12.0
FACE_RETENTION_DAYS=365
DEFAULT_QR_VALIDITY_SECONDS=300
QR_REFRESH_SECONDS=30
DEFAULT_LATE_MINUTES=10
ALLOWED_CLASSROOM_RADIUS_METERS=150
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_PER_MINUTE=60
ENVIRONMENT=development
BIOMETRIC_CONSENT_VERSION=1.0
FORCE_SEED=0
ALLOW_DEV_SECRETS=1
TRUSTED_PROXY_IPS=
