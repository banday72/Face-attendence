# Copy to .env before running Docker Compose.
# Development values below are intentionally local-only. Change every secret for shared/production use.

ENVIRONMENT=development
ALLOW_DEV_SECRETS=1

POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change-me-local-postgres-password

DATABASE_URL=postgresql+psycopg://attendance:change-me-local-postgres-password@postgres:5432/attendance
JWT_SECRET=dev-only-jwt-secret-change-this-before-production
FACE_ENCRYPTION_KEY=dev-only-face-encryption-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FACE_MATCH_THRESHOLD=0.82
FACE_MODEL_NAME=face-api-v1
FACE_LIVENESS_MIN_FRAMES=3
FACE_LIVENESS_MOVEMENT=12.0
FACE_RETENTION_DAYS=365
BIOMETRIC_CONSENT_VERSION=1.0

DEFAULT_QR_VALIDITY_SECONDS=300
QR_REFRESH_SECONDS=30
DEFAULT_LATE_MINUTES=10
ALLOWED_CLASSROOM_RADIUS_METERS=150

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXY_IPS=
RATE_LIMIT_PER_MINUTE=60
FORCE_SEED=0

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# For Vercel deployments using the root vercel.json rewrites, set:
# NEXT_PUBLIC_API_URL=/api/v1
