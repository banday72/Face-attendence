{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "installCommand": "pip install -r requirements.txt",
      "buildCommand": "alembic upgrade head",
      "functions": {
        "app/main.py": {
          "excludeFiles": "{tests/**,__pycache__/**,**/__pycache__/**,**/*.pyc,.pytest_cache/**,.mypy_cache/**,.ruff_cache/**,*.db,*.sqlite,*.sqlite3}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/face/(.*)",
      "destination": "https://face-attendance-api.onrender.com/api/v1/face/$1"
    },
    {
      "source": "/api/v1/attendance/face",
      "destination": "https://face-attendance-api.onrender.com/api/v1/attendance/face"
    },
    {
      "source": "/api/v1/admin/face/(.*)",
      "destination": "https://face-attendance-api.onrender.com/api/v1/admin/face/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
